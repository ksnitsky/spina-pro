<%= render Spina::UserInterface::ModalComponent.new(size: "max-w-screen-md max-h-full overflow-scroll") do |modal| %>
  <%= turbo_frame_tag :message_modal do %>
    <div class="bg-white bg-opacity-75 flex p-3 items-center border-b border-gray-200">
      <div class="space-x-2 flex items-center">
        
        <% if @inbox.forwarding? %>
          <%= button_to spina.forward_admin_pro_inbox_message_path(@inbox, @message), class: "btn btn-default text-xs h-8 px-3", form: {data: {turbo_frame: "_top"}} do %>
            <%= heroicon("mail", style: :solid, class: "w-4 h-4 -ml-1 mr-1") %>
            <%=t "spina.pro.messages.forward_now" %>
          <% end %>
        <% end %>
        
        <% if @message.archived? %>
          <%= button_to spina.unarchive_admin_pro_inbox_message_path(@inbox, @message), class: "btn btn-default text-xs h-8 px-3", form: {data: {turbo_frame: "_top"}} do %>
            <%= heroicon('inbox-in', style: :solid, class: 'w-5 h-5 mr-1 -ml-1') %>
            <%=t "spina.pro.messages.unarchive" %>
          <% end %>
        <% else %>
          <%= form_with url: spina.mark_as_unread_admin_pro_inbox_message_path(@inbox, @message), data: {turbo_frame: "_top"} do |f| %>
            <button class="btn btn-default text-xs h-8 px-3" type="submit">
              <div class="bg-gray-800 h-2.5 w-2.5 mr-1 rounded-full"></div>
              <%= t('spina.pro.messages.mark_as_unread') %>
            </button>
          <% end %>
          
          <%= form_with url: spina.archive_admin_pro_inbox_message_path(@inbox, @message), data: {turbo_frame: "_top"} do |f| %>
            <button type="submit" class="btn btn-default text-xs h-8 px-3">
              <%= heroicon('archive', style: :solid, class: 'w-4 h-4 mr-1 -ml-1') %>
              <%= t('spina.pro.messages.archive') %>
            </button>
          <% end %>
        <% end %>
        
        <% if @message.spam? %>
          <%= form_with url: spina.mark_as_ham_admin_pro_inbox_message_path(@inbox, @message), data: {turbo_frame: "_top"} do |f| %>
            <button class="btn btn-default text-xs h-8 px-3" type="submit">
              <%= heroicon('check', style: :solid, class: 'w-4 h-4 mr-1 -ml-1') %>
              <%= t('spina.pro.messages.not_spam') %>
            </button>
          <% end %>
        <% else %>
          <%= form_with url: spina.mark_as_spam_admin_pro_inbox_message_path(@inbox, @message), data: {turbo_frame: "_top"} do |f| %>
            <button class="btn btn-default text-xs h-8 px-3" type="submit">
              <%= heroicon('x-mark', style: :solid, class: 'w-4 h-4 mr-1 -ml-1') %>
              <%= t('spina.pro.messages.mark_as_spam') %>
            </button>
          <% end %>
        <% end %>
      </div>
      
      <div class="flex-1"></div>
      
      <div class="text-xs text-gray-600 pr-2">
        <%=l @message.created_at, format: :long %>
      </div>
    </div>
  
    <div class="p-6 space-y-4 bg-white bg-opacity-75">
      <table class="table-auto">
        <tr>
          <td class="text-right text-xs font-semibold uppercase text-gray-400 tracking-wide whitespace-nowrap align-middle pb-4 px-3 leading-6">
            <%= image_tag @message.gravatar_url, alt: 'Image', class: 'rounded-md w-12 h-12 inline-block' %>
          </td>
          <td class="font-medium pb-4">
            <div class="text-xl"><%= @message.to_name %></div>
            <div class="text-sm opacity-50">
              <%= @message.email || "Email address unknown" %>
            </div>
          </td>
        </tr>
        <% @message.body_attributes.each do |key| %>
          <% next if @message.send(key).blank? %>
          <tr>
            <td class="text-right text-xs font-semibold uppercase text-gray-400 tracking-wide whitespace-nowrap align-top py-1 px-3 leading-6">
              <%= label_tag key %>
            </td>
            <td class="text-sm py-1 leading-6 whitespace-pre-line"><%= @message.send(key) %></td>
          </tr>
        <% end %>
      </table>
    <% end %>
  </div>
<% end %>
