<%= link_to spina.edit_admin_page_path(page), class: "block px-2 leading-tight", data: {selected: index.zero?, search_target: "result", action: "mouseenter->search#select", turbo_frame: "_top"} do %>
  <div class="flex items-center justify-between w-full px-4 py-3 rounded-md <%= 'bg-gray-400/25' if index.zero? %>" data-selected-class="bg-gray-400/25">
    <div>
      <div class="font-medium flex items-center">
        <%= page.title %>
        <% if page.draft? %>
          <div class="opacity-50 text-xs ml-1">
            (<%=t "spina.pages.concept" %>)
          </div>
        <% end %>
        <% if page.resource_id %>
          <div class="flex items-center ml-2 text-xs px-1.5 py-0.5 space-x-1 bg-gray-900/5 rounded">
            <%= heroicon('collection', style: :outline, class: 'w-3 h-3 opacity-50') %>
            <div class="opacity-75"><%= page.resource&.label %></div>
          </div>
        <% end %>
      </div>
      <div class="opacity-50 text-xs"><%= page.materialized_path %></div>
    </div>
    
    <div class="opacity-0 <%= 'opacity-100' if index.zero? %>" data-selected-class="opacity-100">
      <%= heroicon('arrow-narrow-right', style: :solid, class: 'w-5 h-5 text-gray-600') %>
    </div>
  </div>
<% end %>
