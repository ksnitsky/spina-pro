<nav class="-mb-1 md:-mb-3 mt-4">
  <ul class="inline-flex w-auto rounded-md bg-white">
    <%= render Spina::UserInterface::TabLinkComponent.new(spina.admin_pro_rewrite_rules_path, active: controller_name == 'rewrite_rules' && action_name == 'index') do %>
      <%= heroicon('arrow-right', style: :solid, class: 'h-4 w-4 mr-1 -ml-1 opacity-75') %>
      <%=t "spina.pro.rewrite_rules.rewrite_rules" %>
    <% end %>
    
    <%= render Spina::UserInterface::TabLinkComponent.new(spina.auto_generated_admin_pro_rewrite_rules_path, active: action_name == 'auto_generated') do %>
      <%= heroicon('sparkles', style: :outline, class: 'h-4 w-4 mr-1 opacity-75') %>
      <%=t "spina.pro.rewrite_rules.auto_generated" %>
    <% end %>
    
    <% if Spina::Pro.config.track_not_found_errors %>
      <%= render Spina::UserInterface::TabLinkComponent.new(spina.admin_pro_not_found_errors_path, active: controller_name == 'not_found_errors') do %>
        <%= heroicon('exclamation', style: :outline, class: 'h-4 w-4 mr-1 opacity-75') %>
        <%=t "spina.pro.rewrite_rules.missing_pages" %>
        
        <% if Spina::Pro::NotFoundError.not_ignored.size > 0 %>
          <span class='h-4 bg-yellow-500 rounded flex items-center justify-center text-white text-xs font-bold ml-1 px-1'>
            <% if Spina::Pro::NotFoundError.not_ignored.size > 999 %>
              999+
            <% else %>
              <%= Spina::Pro::NotFoundError.not_ignored.size %>
            <% end %>
          </span>
        <% end %>
      <% end %>
    <% end %>
  </ul>
</nav>