<%= turbo_frame_tag dom_id(not_found_error) do %>

  <div class="flex items-center h-12 hover:bg-white border-b border-gray-200 px-8 text-sm group">
    <div class="flex-1 flex items-center overflow-hidden">      
      <div class="truncate <%= 'line-through' if not_found_error.ignored? %>">
        <%= not_found_error.path %>
      </div>

      <div class="text-xs ml-1 text-yellow-600 whitespace-nowrap">        
        <%=t "spina.pro.not_found_errors.visits", count: not_found_error.visits %>
      </div>
    </div>
    
    <div class="justify-center flex items-center ml-5">
      <div class="opacity-0 group-hover:opacity-100 mr-5">
        <%= link_to spina.new_admin_pro_rewrite_rule_path(old_path: not_found_error.path), class: 'btn btn-default h-7 px-2 text-xs', data: {turbo_frame: "modal"} do %>
          <%=t 'spina.pro.rewrite_rules.add_rewrite_rule' %>
          <%= heroicon('arrow-right', style: :solid, class: 'w-3 h-3 ml-1') %>
        <% end %>
      </div>
      
      <div class="flex items-center text-xs text-gray-500 whitespace-nowrap">
        Last visited: 
        <%=l not_found_error.last_visited, format: :short %>
      </div>
    </div>

    <%= form_with model: not_found_error, url: spina.admin_pro_not_found_error_path(not_found_error) do |f| %>
      <%= f.hidden_field :ignored, value: !not_found_error.ignored? %>
      <%= button_tag type: :submit, class: "block cursor-pointer py-3 px-4 ml-2 text-gray-500 hover:text-gray-900 group-hover:opacity-100 #{'opacity-0' unless not_found_error.ignored?}" do %>
        <%= heroicon('eye-off', style: :solid, class: "w-4 h-4") %>
      <% end %>
    <% end %>
  </div>

<% end %>
